{
  "name": "sellerops-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node ../../scripts/generate-static-seo.mjs",
    "build": "ng build",
    "postbuild": "node ../../scripts/finalize-static-seo.mjs",
    "build:prod": "npm run build && npm run validate:seo",
    "validate:seo": "node ../../scripts/validate-seo.mjs",
    "format": "prettier --write . ../../scripts/*.mjs",
    "format:check": "prettier --check . ../../scripts/*.mjs"
  },
  "dependencies": {
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/forms": "21.2.21",
    "@angular/platform-browser": "21.2.21",
    "@angular/platform-server": "21.2.21",
    "@angular/router": "21.2.21",
    "@angular/ssr": "21.2.21",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/build": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.21",
    "@types/node": "^22.15.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.2"
  }
}
